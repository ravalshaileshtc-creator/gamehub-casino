rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']);
    }

    // Wallets Collection (Authoritative Server Only for Writes)
    match /wallets/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Prohibit client writes to balance or lockedBalance!
    }

    // Wallet Transactions Ledger (Immutable)
    match /walletTransactions/{transactionId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false; // Prohibit client modification of ledger records!
    }

    // Game Bets (Authoritative Server Only)
    match /gameBets/{betId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Game Rounds
    match /gameRounds/{roundId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Games Metadata (Publicly readable)
    match /games/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // Audit Logs (Internal Only)
    match /auditLogs/{logId} {
      allow read, write: if false;
    }
  }
}
